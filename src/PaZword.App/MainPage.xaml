<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaZword.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PaZword.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Sprint-0 spike content: a single label + button bound via {x:Bind} only.
        Demonstrates CommunityToolkit.Mvvm source-gen + DI under AOT.
    -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="0"
            Style="{ThemeResource TitleTextBlockStyle}"
            Foreground="{ThemeResource BrandPrimaryBrush}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}" />

        <Button
            Grid.Row="1"
            HorizontalAlignment="Left"
            Style="{ThemeResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.PingCommand}"
            Content="Ping diagnostics" />
    </Grid>
</Page>

