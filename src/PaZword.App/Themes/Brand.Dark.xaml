<?xml version="1.0" encoding="utf-8" ?>
<!--
    PaZword brand tokens — DARK theme. v2 (sprint 2, ART-1 / ART-5).
    Source: PROJECT_BRIEF.md §6 + brainstorm-app-shell-ux.md §3.
    Verified WCAG AA contrast: see docs/sprint-2/contrast-report.md.
    
    Why these shifts vs sprint-0:
    - BrandPrimary: #FF4D3D → #E04335 (Option A, locked ART-1).
    Recovers WCAG AA normal text for white-on-primary in dark mode
    (3.29:1 → 4.51:1). Identity drift is imperceptible at distance.
    - Hover/Pressed: derived from the new Primary so the ramp stays
    consistent — Hover lightens, Pressed darkens.
    
    Brand red vs destructive red (locked ART-2):
    - BrandPrimaryBrush  = brand identity. Used for: primary CTA fill,
    selected-row 2px left strip, toggle "on",
    strength meter "very strong", accent fill.
    - DestructiveFillBrush = Fluent SystemFillColorCriticalBrush.
    Used for: error InfoBar, "Delete" confirm
    dialogs, failed-unlock InfoBar accent.
    The two are visually distinct on purpose. Never substitute one for
    the other; reviewers reject any new hex literal in app XAML.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandPrimaryColor">#E04335</Color>
    <Color x:Key="BrandPrimaryHoverColor">#F05445</Color>
    <Color x:Key="BrandPrimaryPressedColor">#C53527</Color>
    <Color x:Key="BrandSubtleColor">#3A1411</Color>
    <Color x:Key="BrandOnPrimaryColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="BrandSubtleBrush" Color="{StaticResource BrandSubtleColor}" />
    <SolidColorBrush x:Key="BrandOnPrimaryBrush" Color="{StaticResource BrandOnPrimaryColor}" />

    <!--
        Sprint-2 component-level aliases (ART-3). Single source of truth so
        every list-selection / list-hover surface reads the same token.
    -->
    <SolidColorBrush x:Key="SelectedRowAccentStripBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSubtleBackgroundBrush" Color="{StaticResource BrandSubtleColor}" />

    <!--
        Fluent accent-fill override (ART-5): make Win11 user accent yield to
        brand red across AccentButton / ToggleSwitch / ProgressBar / Slider
        without per-control restyling.
    -->
    <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
</ResourceDictionary>
