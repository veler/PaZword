<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PaZword.App.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PaZword.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Padding="48"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel
            MaxWidth="360"
            HorizontalAlignment="Center"
            Spacing="16">
            <Border
                Width="96"
                Height="96"
                HorizontalAlignment="Center"
                Background="{ThemeResource BrandSubtleBackgroundBrush}"
                CornerRadius="48">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="40"
                    Foreground="{ThemeResource BrandPrimaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}" />
            </Border>
            <TextBlock
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{x:Bind Body, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind BodyVisibility, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind CtaCommand, Mode=OneWay}"
                Content="{x:Bind CtaText, Mode=OneWay}"
                IsEnabled="{x:Bind IsCtaEnabled, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind CtaVisibility, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
