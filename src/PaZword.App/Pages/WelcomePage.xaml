<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PaZword.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:recents="using:PaZword.App.Recents"
    xmlns:local="using:PaZword.App.Pages"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="48,32" RowSpacing="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Headline -->
            <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center" MaxWidth="640">
                <Border
                    Width="80" Height="80"
                    CornerRadius="40"
                    Background="{ThemeResource BrandSubtleBackgroundBrush}"
                    HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="40" Foreground="{ThemeResource BrandPrimaryBrush}" />
                </Border>
                <TextBlock
                    Text="Welcome back"
                    Style="{ThemeResource TitleLargeTextBlockStyle}"
                    TextAlignment="Center" />
                <TextBlock
                    Text="Open a vault to continue, or start a fresh one."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
            </StackPanel>

            <!-- Three tiles -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Command="{x:Bind ViewModel.CreateNewCommand}"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Width="200" Height="160">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="32" Foreground="{ThemeResource BrandPrimaryBrush}" />
                        <TextBlock Text="New vault" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Start fresh"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.OpenExistingCommand}"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Width="200" Height="160">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8E5;" FontSize="32" Foreground="{ThemeResource BrandPrimaryBrush}" />
                        <TextBlock Text="Open existing" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pick a .kdbx file"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.MigrateCommand}"
                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Width="200" Height="160">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74A;" FontSize="32" Foreground="{ThemeResource BrandPrimaryBrush}" />
                        <TextBlock Text="Migrate from PaZword" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="Bring your old vault"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Sprint-3 placeholder banner for "New vault" -->
            <InfoBar
                Grid.Row="2"
                IsOpen="{x:Bind ViewModel.ShowCreateNewBanner, Mode=TwoWay}"
                IsClosable="True"
                Severity="Informational"
                Title="Coming in a future update"
                Message="Creating a brand-new vault from the app arrives in the next sprint. For now, open an existing .kdbx — or create one in KeePassXC and open it here."
                MaxWidth="640"
                HorizontalAlignment="Center" />

            <!-- Recents -->
            <StackPanel Grid.Row="3" Spacing="12" HorizontalAlignment="Center" MaxWidth="640">
                <TextBlock
                    Text="Recent vaults"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />

                <ListView
                    ItemsSource="{x:Bind ViewModel.Recents, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnRecentClicked"
                    Visibility="{x:Bind RecentsListVisibility(ViewModel.HasRecents), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="recents:RecentVaultEntry">
                            <Grid Padding="8,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20"
                                          Foreground="{ThemeResource BrandPrimaryBrush}"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind FileName}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Path}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind LastOpened.LocalDateTime, Mode=OneTime}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Text="No vaults yet — open one above and we'll remember it here."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind EmptyRecentsVisibility(ViewModel.HasRecents), Mode=OneWay}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
